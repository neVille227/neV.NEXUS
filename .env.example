# Copier vers .env (jamais commité). Exemple en local :
DATABASE_URL=postgres://utilisateur:motdepasse@localhost:5432/nevnexus
PORT=3000
NODE_ENV=development
# closed = inscriptions fermées | invite = sur code d'invitation (pilote) | open = ouvertes
REGISTRATION_MODE=invite
INVITE_CODE=changez-moi
# Compte administrateur créé au premier démarrage s'il n'existe pas
ADMIN_EMAIL=admin@exemple.org
ADMIN_PASSWORD=changez-moi-mot-de-passe-long
# PGSSL=true si la base impose TLS (connexion externe)
